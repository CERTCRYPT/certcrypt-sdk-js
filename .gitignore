# Secrets and key material
# ·················
# The issuer's keyset seed is the whole identity: whatever holds it must never be
# committed. These patterns are deliberately broad — a false positive costs one
# `git add -f`, a false negative is unrecoverable once pushed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
*.secrets.*
*.local.*

# Never commit non-public notes
# ·················
*.private.*
*.internal.*

# Build output
# ·················
# `dist/` is not committed but IS published: what ships to npm is governed by the
# `files` allowlist in package.json, not by this file.
dist/
*.tsbuildinfo

# Dependencies
# ·················
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# Test and coverage output
# ·················
coverage/
.nyc_output/

# Logs
# ·················
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
# ·················
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Scratch
# ·················
tmp/
.tmp/
*.bak
